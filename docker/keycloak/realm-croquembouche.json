{
  "realm": "croquembouche",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full administrative access to Croquembouche"
      },
      {
        "name": "user",
        "description": "Standard Croquembouche user"
      }
    ],
    "client": {
      "croquembouche-backend": [
        {
          "name": "admin",
          "description": "Full administrative access to Croquembouche"
        },
        {
          "name": "user",
          "description": "Standard Croquembouche user"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "croquembouche-dev-team",
      "path": "/croquembouche-dev-team"
    }
  ],
  "clients": [
    {
      "clientId": "croquembouche-backend",
      "name": "Croquembouche BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "dev-only-secret-not-for-prod",
      "redirectUris": [
        "http://localhost:8000/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080##http://localhost:5173",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "client-roles-in-userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "croquembouche-backend",
            "claim.name": "resource_access.croquembouche-backend.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "michou",
      "email": "michou@example.com",
      "firstName": "Michou",
      "lastName": "Dev",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "croquembouche-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "user"
      ],
      "clientRoles": {
        "croquembouche-backend": [
          "admin",
          "user"
        ]
      }
    },
    {
      "username": "julie",
      "email": "julie@example.com",
      "firstName": "Julie",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "croquembouche-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ],
      "clientRoles": {
        "croquembouche-backend": [
          "user"
        ]
      },
      "groups": [
        "/croquembouche-dev-team"
      ]
    }
  ]
}
