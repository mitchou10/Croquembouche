{{- range $allValues }}
  {{- $keyParts := splitList "." .Key }}
  {{- $top := index $keyParts 0 }}
  {{- if eq $top "global" }}
    {{- if eq (len $keyParts) 2 }}
      {{- $global = append $global . }}
    {{- end }}
  {{- else if eq (len $keyParts) 1 }}
    {{- $general = append $general . }}
  {{- else }}
    {{- $found := false }}
    {{- range $topLevelKeys }}
      {{- if eq . $top }}
        {{- $found = true }}
      {{- end }}
    {{- end }}
    {{- if not $found }}
      {{- $topLevelKeys = append $topLevelKeys $top }}
    {{- end }}
  {{- end }}
{{- end }}

