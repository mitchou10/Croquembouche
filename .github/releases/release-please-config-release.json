{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "versioning": "prerelease",
      "prerelease": false,
      "prerelease-type": "",
      "extra-files": [
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "backend/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "backend/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='croquembouche-backend')].version"
        },
        {
          "type": "toml",
          "path": "worker/template_matching/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "worker/template_matching/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='croquembouche-worker-template-matching')].version"
        },
        {
          "type": "toml",
          "path": "worker/ocr/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "worker/ocr/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='croquembouche-worker-ocr')].version"
        },
        {
          "type": "toml",
          "path": "worker/gliner/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "worker/gliner/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='croquembouche-worker-gliner')].version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Bug Fixes",
          "hidden": false
        },
        {
          "type": "perf",
          "section": "Performance Improvements",
          "hidden": false
        },
        {
          "type": "revert",
          "section": "Reverts",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Code Refactoring",
          "hidden": false
        },
        {
          "type": "build",
          "section": "Dependencies",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Styles",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous Chores",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Continuous Integration",
          "hidden": true
        }
      ]
    }
  }
}
